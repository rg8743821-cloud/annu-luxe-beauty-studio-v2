# ==========================================================================
# Annu's Luxe Beauty Studio — Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit your real ".env" file or hardcode credentials in the code.
# ==========================================================================

# SMTP host of your email provider (e.g. smtp.gmail.com)
MAIL_HOST=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
MAIL_PORT=587

# The mailbox used to SEND emails from (e.g. a Gmail address with an
# "App Password" generated from Google Account > Security > App Passwords)
MAIL_USER=your-email@gmail.com

# App password / SMTP password for MAIL_USER (never your normal login password)
MAIL_PASS=your-app-password

# The business inbox that should RECEIVE booking & contact notifications
MAIL_TO=annugupta0692@gmail.com

# Port the Express server listens on (optional, defaults to 3000)
PORT=3000
